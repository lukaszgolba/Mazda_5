<Window x:Class="mazda_5.Views.AdapterInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informacje o Adapterze"
        Width="600" Height="500">

    <TabControl>

        <!-- 1. Informacje ELM -->
        <TabItem Header="ELM Info">
            <ScrollViewer>
                <TextBox x:Name="ElmBox"
                         FontFamily="Consolas"
                         FontSize="14"
                         IsReadOnly="True"
                         TextWrapping="Wrap"/>
            </ScrollViewer>
        </TabItem>

        <!-- 2. Informacje STN/MIC -->
        <TabItem Header="STN/MIC Info">
            <ScrollViewer>
                <TextBox x:Name="StnBox"
                         FontFamily="Consolas"
                         FontSize="14"
                         IsReadOnly="True"
                         TextWrapping="Wrap"/>
            </ScrollViewer>
        </TabItem>

        <!-- 3. VLinker FS – pełne info -->
        <TabItem Header="VLinker FS">
            <ScrollViewer>
                <TextBox x:Name="VlinkerBox"
                         FontFamily="Consolas"
                         FontSize="14"
                         IsReadOnly="True"
                         TextWrapping="Wrap"/>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
