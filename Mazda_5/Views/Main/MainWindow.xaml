<Window
    x:Class="mazda_5.Views.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mazda Diagnostic" Height=" 480" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--  Lewy Panel  -->
        <StackPanel Grid.Column="0"  Background="#EEE" Margin="10,0,10,0"  >
            <Button x:Name="BtnConnect" Content="Połączenie" Click="Menu_Connect" />
            <Button x:Name="BtnVIN" Content="Odczyt VIN" Click="Menu_VIN" />
            <Button x:Name="BtnDTC" Content="Odczyt DTC" Click="Menu_DTC" />
            <Button x:Name="BtnLive" Content="Live Data" Click="Menu_Live" />
            <Button x:Name="BtnModules" Content="Moduły" Click="Menu_Modules" />
            <Button x:Name="BtnSettings" Content="USTAWIENIA" Click="Menu_Settings" />
            
        </StackPanel>
        <!--  Prawy Panel-->
        <ContentControl x:Name="MainContent" Grid.Column="1" Grid.ColumnSpan="2"/>

    </Grid>
</Window>
