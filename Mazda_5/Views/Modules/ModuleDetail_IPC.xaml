<UserControl x:Class="mazda_5.Views.Modules.ModuleDetail_IPC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <StackPanel Margin="20">

        <TextBlock Text="IPC – Zestaw wskaźników"                  
                   FontSize="26" 
                   TextAlignment="Center"
                   FontWeight="Bold" 
                   Margin="0 0 0 20"/>

        <Button Content="Test zegarów"
                Height="40"
                Width="250" 
                Margin="0 0 0 10"
                Click="GaugeSweep_Click"/>

        <Button Content="Parametry IPC"
                Height="40" 
                Width="250"
                Margin="0 0 0 10"
                Click="ReadParams_Click"/>

        <TextBlock Text="Konfiguracja IPC" 
                   FontSize="20"
                   TextAlignment="Center"
                   Margin="0 20 0 10"/>

        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="DidBox"
                     Width="120" 
                     Height="30" 
                     Text="DID"
                     TextAlignment="Center"
                     FontSize="16"
                     Margin="0 0 10 0"/>
            <TextBox x:Name="ValueBox" 
                     Width="120" 
                     Height="30" 
                     Text="Value"
                     TextAlignment="Center"
                     FontSize="16"
                     Margin="0 0 10 0"/>
            <Button Content="Zapisz" 
                    Width="120" 
                    Height="30" 
                    Click="WriteConfig_Click"/>
        </StackPanel>

        <TextBlock x:Name="Output" FontSize="16" Margin="0 20 0 0"/>

    </StackPanel>
</UserControl>
