<UserControl x:Class="mazda_5.Views.Modules.ModuleDetail_BCM"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <StackPanel Margin="20">

        <TextBlock Text="BCM – Moduł nadwozia"
                   FontSize="26" 
                   FontWeight="Bold" 
                   TextAlignment="Center"
                   Margin="0 0 0 20"/>

        <Button Content="Parametry BCM"
                Height="40" 
                Width="250"
                Margin="0 0 0 10"
                Click="ReadParams_Click"/>

        <TextBlock Text="Konfiguracja BCM" 
                   FontSize="20"
                   TextAlignment="Center"
                   Margin="0 20 0 10"/>

        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="DidBox"
                     Width="120" 
                     Height="30"
                     Text="DID"
                     TextAlignment="Center"
                     FontSize="16"
                     Margin="0 0 10 0"/>
            <TextBox x:Name="ValueBox" 
                     Width="120" 
                     Height="30" 
                     Text="Value"
                     TextAlignment="Center"
                     FontSize="16"
                     Margin="0 0 10 0"/>
            <Button Content="Zapisz" 
                    Width="120"
                    Height="30" 
                    Click="WriteConfig_Click"/>
        </StackPanel>

        <TextBlock x:Name="Output" FontSize="16" Margin="0 20 0 0"/>

    </StackPanel>
</UserControl>
