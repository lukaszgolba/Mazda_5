<UserControl x:Class="mazda_5.Views.Diagnostics.DtcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">
        <TextBlock Text="Odczyt DTC" 
                   TextAlignment="Center" 
                   FontSize="20" 
                   Margin="10"/>
        
        <Button Content="Odczytaj DTC" 
                Click="ReadDtc_Click" 
                Width="150" 
                Margin="0,10,0,0"/>
        
        <Button Content="Kasuj błędy"
                Click="ClearDtc_Click" 
                Width="150" 
                Margin="0,10,0,0"/>


        <ListBox x:Name="DtcList"
         Margin="10"
         Background="#111"
         Foreground="White"
         FontSize="16"
         BorderThickness="0">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{Binding Color}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- KOD -->
                        <TextBlock Text="{Binding Code}"
                           Grid.Column="0"
                           FontWeight="Bold"/>

                        <!-- OPIS -->
                        <TextBlock Text="{Binding Description}"
                           Grid.Column="1"/>

                        <!-- MODUŁ -->
                        <TextBlock Text="{Binding Module}"
                           Grid.Column="2"
                           FontStyle="Italic"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </StackPanel>
</UserControl>