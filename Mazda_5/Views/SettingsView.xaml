<UserControl x:Class="mazda_5.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">

        <TextBlock Text="Ustawienia Adaptera"
                   TextAlignment="Center"
                   FontSize="20"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Port COM:"
                   TextAlignment="Center"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="PortList"
                  Width="200"
                  HorizontalContentAlignment="Center"
                  Margin="0,0,0,10"/>
        
        <TextBlock Text="Prędkość Baud:"
                   TextAlignment="Center"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="BaudList"
                  Width="200"
                  HorizontalContentAlignment="Center"
                  Margin="0,0,0,10"/>
        
        <Button Content="Zapisz Ustawienia"
                Width="200"
                HorizontalAlignment="Center"
                Click="SaveSettings_Click"
                Margin="0,10,0,10"/>

        <TextBox x:Name="OutputBox"
                 Height="200"
                 Width="200"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
</UserControl>
